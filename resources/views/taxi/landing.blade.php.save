    {{-- 🗺️ Leaflet Dark Map --}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const map = L.map('taxiMap', { zoomControl: false }).setView([33.5138, 36.2765], 13);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap & CARTO',
                subdomains: 'abcd',
                maxZoom: 19
            }).addTo(map);

            let driverMarkers = [];

            // 📍 موقع المستخدم
            function addUserMarker(lat, lng) {
                L.marker([lat, lng])
                    .addTo(map)
                    .bindPopup("<b>📍 موقعك الحالي</b>")
                    .openPopup();
            }

            // 🚗 إنشاء سائقين وهميين
            function generateDrivers(lat, lng) {
                for (let i = 0; i < 8; i++) {
                    const driverLat = lat + (Math.random() - 0.5) * 0.02;
                    const driverLng = lng + (Math.random() - 0.5) * 0.02;

                    const marker = L.marker([driverLat, driverLng]).addTo(map)
                        .bindPopup("🚖 سائق قريب منك");
                    driverMarkers.push(marker);
                }
            }

            // 🔁 تحريك السيارات بشكل عشوائي
            function moveDrivers() {
                driverMarkers.forEach(marker => {
                    const oldLatLng = marker.getLatLng();
                    const newLat = oldLatLng.lat + (Math.random() - 0.5) * 0.0015;
                    const newLng = oldLatLng.lng + (Math.random() - 0.5) * 0.0015;
                    marker.setLatLng([newLat, newLng]);
                });
            }

            // 📡 تفعيل الموقع
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition((pos) => {
                    const userLat = pos.coords.latitude;
                    const userLng = pos.coords.longitude;

                    map.setView([userLat, userLng], 14);
                    addUserMarker(userLat, userLng);
                    generateDrivers(userLat, userLng);

                    // تحديث حركة السائقين كل 5 ثوانٍ
                    setInterval(moveDrivers, 5000);
                }, () => {
                    // موقع افتراضي دمشق
                    addUserMarker(33.5138, 36.2765);
                    generateDrivers(33.5138, 36.2765);
                    setInterval(moveDrivers, 5000);
                });
            } else {
                addUserMarker(33.5138, 36.2765);
                generateDrivers(33.5138, 36.2765);
                setInterval(moveDrivers, 5000);
            }
        });
    </script>
</x-app-layout>
